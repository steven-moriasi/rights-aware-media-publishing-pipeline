FROM node:22.22.2-bookworm-slim
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg \
  && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY lib ./lib
COPY worker ./worker
COPY tsconfig.json ./
USER node
CMD ["node_modules/.bin/tsx", "worker/transform-worker.ts"]
